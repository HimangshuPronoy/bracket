{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "ignoreDeprecations": "5.0",
    "types": ["jest", "node"],
    "rootDir": ".",
    "outDir": "dist-test"
  },
  "include": ["src/lib/bracket/**/*.ts", "__tests__/bracket.node.test.ts"],
  "exclude": ["node_modules"]
}
